---
const features = [
  {
    title: "Exploración y análisis del sonido",
    description:
      "Estudio de las propiedades del sonido en el tiempo y el espacio, su percepción y su impacto en diferentes contextos.",
    icon: "/icons/waveform.svg",
  },
  {
    title: "Sonido como arte y funcionalidad",
    description:
      "Comprensión del sonido tanto en su expresión artística como en su uso práctico, ritual y comunicativo.",
    icon: "/icons/book-open-variant.svg",
  },
  {
    title: "Automatización con Python para audio e imagen",
    description:
      "Scripts a medida para procesamiento, análisis y transformación de sonido e imagen, optimizando flujos de trabajo creativos.",
    icon: "/icons/puzzle.svg",
  },
  {
    title: "Herramientas con IA generativa",
    description:
      "Integración de modelos de IA para generación y edición de audio e imagen, aplicados a proyectos musicales y de contenido.",
    icon: "/icons/heart-pulse.svg",
  },
  {
    title: "Desarrollo backend para creadores de contenido",
    description:
      "Node.js, Express y bases de datos, aplicado a herramientas y automatizaciones para músicos y creadores.",
    icon: "/icons/code-braces.svg",
  },
  {
    title: "Frontend y experiencia de usuario",
    description:
      "Astro, Tailwind y buenas prácticas de accesibilidad, velocidad de carga y usabilidad.",
    icon: "/icons/eye-circle.svg",
  },
];
---

<div id="j75-features" class="py-28">
  <div class="container max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {
        features.map((feature) => (
          <div class="flex items-start space-x-4 animate-fade-in">
            <span class="flex items-center justify-center w-16 h-16 bg-white rounded-full">
              <img
                src={feature.icon}
                alt={feature.title}
                class="w-8 h-8 text-[#DD356E]"
              />
            </span>
            <div class="flex-1">
              <h3 class="text-2xl font-inconsolata font-normal mb-2">
                {feature.title}
              </h3>
              <p class="text-[15px] text-white mb-2">{feature.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
</style>
